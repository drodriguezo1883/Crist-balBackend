# Copiar este archivo como application.properties y completar los valores.
# application.properties esta en .gitignore: nunca commitear credenciales reales.

# Railway asigna el puerto via variable de entorno PORT
server.port=${PORT:8080}

# Origenes permitidos para CORS, separados por coma.
# Produccion: https://codigocristobal.com,https://www.codigocristobal.com
app.cors.allowed-origin=${CORS_ALLOWED_ORIGIN:http://localhost:4200}

# MySQL (Railway). En produccion definir estas variables en el servicio:
#   DB_URL      -> jdbc:mysql://mysql.railway.internal:3306/railway
#   DB_USERNAME -> root
#   DB_PASSWORD -> (password del servicio MySQL)
# En desarrollo local se usa la base de prueba cristobal_test (misma instancia).
spring.datasource.url=${DB_URL:jdbc:mysql://HOST:PUERTO/cristobal_test?sslMode=REQUIRED}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:CAMBIAR}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# update crea/ajusta tablas automaticamente. Cuando el esquema este estable
# en produccion, cambiar a validate para que Hibernate no altere tablas.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
